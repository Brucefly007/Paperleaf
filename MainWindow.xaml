<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="纸间 · Paperleaf" Width="1220" Height="840" MinWidth="840" MinHeight="580"
        Background="#F4F3EF" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" AllowDrop="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#27352F"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="13,9"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E3E9E1"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#D0DDD0"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="13,9"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#DBE6DA"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E3E9E1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="9,7"/><Setter Property="BorderBrush" Value="#DCE0D8"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ToolTip"><Setter Property="FontSize" Value="12"/></Style>
  </Window.Resources>
  <Grid Background="#F4F3EF">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="Sidebar" Background="#EBEDE6" BorderBrush="#DDE1D7" BorderThickness="0,0,1,0">
      <Grid Margin="20,26,20,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal"><Border Background="#315C47" CornerRadius="8" Width="34" Height="34"><TextBlock Text="纸" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="纸间" FontSize="23" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
          <TextBlock Text="P A P E R L E A F" FontSize="10" Foreground="#738174" Margin="0,13,0,29"/>
          <TextBlock Text="留一页，给想法。" FontSize="14" Foreground="#536352" Margin="0,0,0,24"/>
          <Button x:Name="NewButton" Content="＋  新建文档" Background="#DDE5D8" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
          <Button x:Name="OpenButton" Content="打开文档…" Margin="0,0,0,28"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
          <TextBlock DockPanel.Dock="Top" Text="最近打开" FontSize="11" Foreground="#7B8679" Margin="4,0,0,10"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="RecentPanel"/></ScrollViewer>
        </DockPanel>
        <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
          <Border x:Name="SidebarTip" Background="#E2E7DC" CornerRadius="8" Padding="13" Margin="0,18,0,16">
            <StackPanel><TextBlock Text="文字与图片，在一起" FontWeight="SemiBold" Foreground="#4F644D" Margin="0,0,0,8"/><TextBlock Text="粘贴文字、截图或图片。&#10;保存为一个 HTML 文档，&#10;也可导出 Markdown 给 AI。" Foreground="#70806A" FontSize="11" LineHeight="20" TextWrapping="Wrap"/></StackPanel>
          </Border>
          <Button x:Name="HelpButton" Content="使用说明  ↗" Foreground="#738174"/>
          <TextBlock Text="本地保存 · 无需联网" Foreground="#8B9385" FontSize="10" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="Auto" MinHeight="50"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border BorderBrush="#DFE2D9" BorderThickness="0,0,0,1" Padding="28,0,24,0">
        <DockPanel VerticalAlignment="Center">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <ToggleButton x:Name="ReadButton" Content="阅读" ToolTip="阅读模式 · Ctrl+Shift+R" Margin="0,0,4,0"/>
            <Button x:Name="SaveButton" Content="保存" ToolTip="保存 · Ctrl+S"/>
            <Button x:Name="MoreButton" Content="···" FontWeight="Bold" ToolTip="另存为、导出纯文本"/>
            <Button x:Name="ExportButton" Content="导出给 AI  ↗" Background="#D7E4D5" Margin="8,0,0,0" ToolTip="导出 Markdown 和图片到同一文件夹"/>
          </StackPanel>
          <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
            <TextBlock x:Name="DocumentName" Text="未命名文档" FontWeight="SemiBold" FontSize="17" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SaveState" Text="尚未保存" Foreground="#84907F" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Grid.Row="1" BorderBrush="#E3E5DD" BorderThickness="0,0,0,1" Padding="20,5">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="FindButton" Content="查找" ToolTip="查找 Ctrl+F · 替换 Ctrl+H"/><ToggleButton x:Name="FocusButton" Content="专注" ToolTip="隐藏侧栏 · F11"/></StackPanel>
          <WrapPanel x:Name="FormatTools" Orientation="Horizontal">
            <ComboBox x:Name="ParagraphStyle" Width="94" SelectedIndex="0" VerticalContentAlignment="Center" BorderBrush="#DDE1D7" Background="#F4F3EF" Margin="2,2,10,2">
              <ComboBoxItem Content="正文"/><ComboBoxItem Content="标题 1"/><ComboBoxItem Content="标题 2"/><ComboBoxItem Content="标题 3"/>
            </ComboBox>
            <Button x:Name="BoldButton" Content="B" FontWeight="Bold" FontSize="15" ToolTip="加粗 · Ctrl+B"/>
            <Button x:Name="ItalicButton" Content="I" FontStyle="Italic" FontFamily="Georgia" FontSize="16" ToolTip="斜体 · Ctrl+I"/>
            <Button x:Name="ColorButton" ToolTip="修改选中文字的颜色，也可先选颜色再输入">
              <StackPanel Orientation="Horizontal"><Grid Margin="0,0,6,0"><TextBlock Text="A" FontWeight="SemiBold"/><Rectangle x:Name="ColorSwatch" Height="3" VerticalAlignment="Bottom" Fill="#303C34" Margin="0,0,0,-3"/></Grid><TextBlock Text="颜色 ▾"/></StackPanel>
            </Button>
            <Button x:Name="ListButton" Content="≡ 列表" ToolTip="项目列表"/>
            <Rectangle Width="1" Fill="#DDE1D7" Margin="10,6"/>
            <Button x:Name="ImageButton" Content="＋ 图片" ToolTip="插入图片 · Ctrl+Shift+I"/>
            <Button x:Name="UndoButton" Content="↶" FontSize="19" Padding="9,3" ToolTip="撤销 · Ctrl+Z"/>
            <Button x:Name="RedoButton" Content="↷" FontSize="19" Padding="9,3" ToolTip="重做 · Ctrl+Y"/>
          </WrapPanel>
        </DockPanel>
      </Border>
      <Border x:Name="FindBar" Grid.Row="2" Background="#E9EDE4" Padding="24,9" Visibility="Collapsed">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="查找" VerticalAlignment="Center" Foreground="#536352"/>
            <TextBox x:Name="FindInput" Grid.Column="1" MinWidth="70" Margin="0,0,8,0" ToolTip="按文字查找，不区分大小写；Enter 下一处，Shift+Enter 上一处"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button x:Name="FindPreviousButton" Content="上一处" Padding="9,7" ToolTip="Shift+F3"/>
              <Button x:Name="FindNextButton" Content="下一处" Padding="9,7" ToolTip="F3"/>
              <ToggleButton x:Name="ReplaceToggle" Content="替换" Padding="9,7" ToolTip="显示替换 · Ctrl+H"/>
              <Button x:Name="CloseFindButton" Content="关闭" Padding="9,7" ToolTip="Esc"/>
            </StackPanel>
          </Grid>
          <Grid x:Name="ReplaceRow" Visibility="Collapsed" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="替换为" VerticalAlignment="Center" Foreground="#536352"/>
            <TextBox x:Name="ReplaceInput" Grid.Column="1" MinWidth="70" Margin="0,0,8,0" ToolTip="留空表示删除匹配文字；Enter 替换当前一处"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button x:Name="ReplaceOneButton" Content="替换此处" Padding="12,7" ToolTip="替换选中的匹配，再定位下一处；尚未定位时先查找"/>
              <Button x:Name="ReplaceAllButton" Content="全部替换" Padding="12,7" Background="#D7E4D5" ToolTip="替换整篇文档中的所有匹配，可按 Ctrl+Z 一次撤销"/>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="FindResult" Text="Enter 下一处 · Shift+Enter 上一处 · 不区分大小写" Foreground="#70806A" FontSize="11" Margin="50,6,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Border>
      <Grid Grid.Row="3" Margin="24,20,24,18">
        <Border Background="White" BorderBrush="#E4E5DC" BorderThickness="1" CornerRadius="3" MaxWidth="920">
          <Grid>
          <RichTextBox x:Name="Editor" BorderThickness="0" Background="Transparent" Padding="54,40,54,60" FontSize="17" Foreground="#303C34" AcceptsTab="True" SpellCheck.IsEnabled="False" IsDocumentEnabled="True" IsInactiveSelectionHighlightEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
          <TextBlock x:Name="EmptyHint" Text="从一句话开始…&#10;&#10;在这里写字，或按 Ctrl+V 粘贴文字和图片。" IsHitTestVisible="False" Foreground="#A2ABA0" FontSize="16" Margin="60,48,40,0" HorizontalAlignment="Left" VerticalAlignment="Top" LineHeight="30"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#EBEDE6" BorderBrush="#DDE1D7" BorderThickness="0,1,0,0" Padding="20,0">
      <DockPanel><TextBlock x:Name="ModeState" Text="编辑模式" Foreground="#778471" VerticalAlignment="Center" DockPanel.Dock="Right"/><TextBlock x:Name="StatsText" Text="0 字 · 0 张图片" Foreground="#778471" Margin="20,0" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Right"/><TextBlock x:Name="StatusText" Text="准备就绪" Foreground="#778471" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"/></DockPanel>
    </Border>
  </Grid>
</Window>
